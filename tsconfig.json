{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "esnext",
		"target": "es6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"importHelpers": true,
		"lib": [
			"dom",
			"es5",
			"scripthost",
			"ESNext"
		]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "reference"]
}
